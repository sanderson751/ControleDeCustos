rules_version = '2';

// ---------------------------------------------------------------------------
// Controle de Custos — regras de seguranca do Firestore
//
// O app e uma SPA sem backend: estas regras sao a UNICA barreira de seguranca.
// A matriz de permissoes da UI (src/domain/rules/permissions.ts) deve
// permanecer espelhada aqui.
//
//   admin    -> CRUD nos proprios custos + gestao de nome/papel de outros usuarios
//   standard -> CRUD nos proprios custos
//   guest    -> somente leitura dos proprios custos
// ---------------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function requesterPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function currentRole() {
      return isSignedIn() && exists(requesterPath())
        ? get(requesterPath()).data.get('role', 'standard')
        : 'none';
    }

    function isAdmin() {
      return currentRole() == 'admin';
    }

    function canWriteCosts() {
      return currentRole() in ['admin', 'standard'];
    }

    function isValidRole(role) {
      return role in ['admin', 'standard', 'guest'];
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isDefaultCategory(category) {
      return category in [
        'moradia', 'alimentacao', 'transporte', 'saude', 'educacao', 'lazer', 'outros'
      ];
    }

    // Categoria padrao ou personalizada existente do PROPRIO usuario.
    function isValidCategory(userId, category) {
      return category is string
        && (isDefaultCategory(category)
          || (category.matches('^[A-Za-z0-9]{1,40}$')
            && exists(/databases/$(database)/documents/users/$(userId)/categories/$(category))));
    }

    function isValidCategoryDoc(data) {
      return data.keys().hasOnly(['userId', 'name', 'archived', 'createdAt', 'updatedAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 40
        && data.name.matches('.*[^ ].*')
        && data.archived is bool;
    }

    function isValidBudget(userId, data) {
      return isValidCategory(userId, data.category)
        && data.year is int
        && data.year >= 2000
        && data.year <= 2100
        && data.month is int
        && data.month >= 1
        && data.month <= 12
        && data.limit is number
        && data.limit > 0
        && data.limit <= 1000000000;
    }

    // Vigencia recorrente: limit null encerra a recorrencia a partir do mes.
    function isValidRecurringBudget(userId, data) {
      return isValidCategory(userId, data.category)
        && data.year is int
        && data.year >= 2000
        && data.year <= 2100
        && data.month is int
        && data.month >= 1
        && data.month <= 12
        && (data.limit == null
          || (data.limit is number && data.limit > 0 && data.limit <= 1000000000));
    }

    // Id deterministico do orcamento: AAAA-MM-categoria (ex.: 2026-03-alimentacao).
    function expectedBudgetId(data) {
      return string(data.year) + '-' + (data.month < 10 ? '0' : '')
        + string(data.month) + '-' + data.category;
    }

    // Lancamento gerado por recorrencia: id rec-<recorrencia>-<AAAA-MM>.
    function isValidOccurrenceId(entryId, data) {
      return data.get('recurringId', '') == ''
        || entryId.matches('^rec-' + data.recurringId + '-[0-9]{4}-[0-9]{2}$');
    }

    function isValidCost(userId, data) {
      return isValidCategory(userId, data.category)
        && data.accountName is string
        && data.accountName.size() > 0
        && data.accountName.size() <= 200
        && data.get('description', '') is string
        && data.get('description', '').size() <= 500
        && data.get('recurringId', '') is string
        && (data.get('recurringId', '') == ''
          || data.recurringId.matches('^[A-Za-z0-9]{1,40}$'))
        && data.amount is number
        && data.amount > 0
        && data.costType in ['fixo', 'variavel']
        && data.installmentsTotal is int
        && data.installmentsTotal >= 1
        && data.installmentsTotal <= 120
        && data.competenceYear is int
        && data.competenceMonth is int
        && data.competenceMonth >= 1
        && data.competenceMonth <= 12;
    }

    // Recorrencia mensal (gera um lancamento por competencia no cliente).
    function isValidRecurringCost(userId, data) {
      return data.keys().hasOnly(['userId', 'accountName', 'amount', 'costType', 'category',
          'description', 'dayOfMonth', 'startYear', 'startMonth', 'active',
          'lastGeneratedYear', 'lastGeneratedMonth', 'createdAt', 'updatedAt'])
        && data.accountName is string
        && data.accountName.size() > 0
        && data.accountName.size() <= 200
        && data.amount is number
        && data.amount > 0
        && data.amount <= 1000000000
        && data.costType in ['fixo', 'variavel']
        && isValidCategory(userId, data.category)
        && data.get('description', '') is string
        && data.get('description', '').size() <= 500
        && data.dayOfMonth is int
        && data.dayOfMonth >= 1
        && data.dayOfMonth <= 28
        && data.startYear is int
        && data.startYear >= 2000
        && data.startYear <= 2100
        && data.startMonth is int
        && data.startMonth >= 1
        && data.startMonth <= 12
        && data.active is bool
        // Cursor completo: ano e mes juntos (ambos nulos ou ambos validos).
        && ((data.get('lastGeneratedYear', null) == null
            && data.get('lastGeneratedMonth', null) == null)
          || (data.get('lastGeneratedYear', null) is int
            && data.lastGeneratedYear >= 2000
            && data.lastGeneratedYear <= 2100
            && data.get('lastGeneratedMonth', null) is int
            && data.lastGeneratedMonth >= 1
            && data.lastGeneratedMonth <= 12));
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      // Cadastro do proprio perfil: sempre com papel padrao (nunca auto-promocao).
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role == 'standard';

      // O proprio usuario atualiza dados de login/nome, mas nunca o papel.
      allow update: if isOwner(userId)
        && !changedKeys().hasAny(['role', 'createdAt'])
        && request.resource.data.get('uid', userId) == userId;

      // Admin altera somente nome e papel de OUTROS usuarios
      // (impede que o ultimo admin remova o proprio acesso).
      allow update: if isAdmin()
        && request.auth.uid != userId
        && changedKeys().hasOnly(['displayName', 'role', 'updatedAt'])
        && isValidRole(request.resource.data.role)
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0;

      allow delete: if false;

      // Preferencias de interface (tema, menu) — pessoais, inclusive para guest.
      match /settings/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Categorias personalizadas: nunca excluidas (arquivar preserva o historico).
      match /categories/{categoryId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && canWriteCosts()
          && request.resource.data.userId == userId
          && isValidCategoryDoc(request.resource.data);

        allow update: if isOwner(userId)
          && canWriteCosts()
          && !changedKeys().hasAny(['userId', 'createdAt'])
          && isValidCategoryDoc(request.resource.data);

        allow delete: if false;
      }

      match /recurringCosts/{recurringId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && canWriteCosts()
          && request.resource.data.userId == userId
          && isValidRecurringCost(userId, request.resource.data);

        allow update: if isOwner(userId)
          && canWriteCosts()
          && !changedKeys().hasAny(['userId', 'createdAt'])
          && isValidRecurringCost(userId, request.resource.data);

        allow delete: if isOwner(userId) && canWriteCosts();
      }

      match /costEntries/{entryId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && canWriteCosts()
          && request.resource.data.userId == userId
          && isValidCost(userId, request.resource.data)
          && isValidOccurrenceId(entryId, request.resource.data);

        allow update: if isOwner(userId)
          && canWriteCosts()
          && request.resource.data.get('userId', userId) == userId
          && !changedKeys().hasAny(['userId', 'createdAt'])
          && isValidCost(userId, request.resource.data)
          && isValidOccurrenceId(entryId, request.resource.data);

        allow delete: if isOwner(userId) && canWriteCosts();
      }

      // Orcamento mensal por categoria (id deterministico AAAA-MM-categoria).
      match /budgetLimits/{budgetId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && canWriteCosts()
          && request.resource.data.userId == userId
          && isValidBudget(userId, request.resource.data)
          && budgetId == expectedBudgetId(request.resource.data);

        allow update: if isOwner(userId)
          && canWriteCosts()
          && !changedKeys().hasAny(['userId', 'year', 'month', 'category', 'createdAt'])
          && isValidBudget(userId, request.resource.data);

        allow delete: if isOwner(userId) && canWriteCosts();
      }

      // Vigencias de orcamento recorrente (id = mes de inicio AAAA-MM-categoria).
      match /recurringBudgets/{budgetId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && canWriteCosts()
          && request.resource.data.userId == userId
          && isValidRecurringBudget(userId, request.resource.data)
          && budgetId == expectedBudgetId(request.resource.data);

        allow update: if isOwner(userId)
          && canWriteCosts()
          && !changedKeys().hasAny(['userId', 'year', 'month', 'category', 'createdAt'])
          && isValidRecurringBudget(userId, request.resource.data);

        allow delete: if isOwner(userId) && canWriteCosts();
      }
    }
  }
}
