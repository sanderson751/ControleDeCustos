rules_version = '2';

// ---------------------------------------------------------------------------
// Controle de Custos — regras de seguranca do Firestore
//
// O app e uma SPA sem backend: estas regras sao a UNICA barreira de seguranca.
// A matriz de permissoes da UI (src/domain/rules/permissions.ts) deve
// permanecer espelhada aqui.
//
//   admin    -> CRUD nos proprios custos + gestao de nome/papel de outros usuarios
//   standard -> CRUD nos proprios custos
//   guest    -> somente leitura dos proprios custos
//
// Lista de mercado compartilhada: o dono convida um e-mail (groceryInvites);
// quem aceita com o e-mail CONFIRMADO entra em memberIds e altera so os itens
// da lista aberta (e le/cria produtos sem preco no catalogo do dono).
// ---------------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function requesterPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function currentRole() {
      return isSignedIn() && exists(requesterPath())
        ? get(requesterPath()).data.get('role', 'standard')
        : 'none';
    }

    function isAdmin() {
      return currentRole() == 'admin';
    }

    function canWriteCosts() {
      return currentRole() in ['admin', 'standard'];
    }

    function isValidRole(role) {
      return role in ['admin', 'standard', 'guest'];
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isDefaultCategory(category) {
      return category in [
        'moradia', 'alimentacao', 'transporte', 'saude', 'educacao', 'lazer', 'outros'
      ];
    }

    // Categoria padrao ou personalizada existente do PROPRIO usuario.
    function isValidCategory(userId, category) {
      return category is string
        && (isDefaultCategory(category)
          || (category.matches('^[A-Za-z0-9]{1,40}$')
            && exists(/databases/$(database)/documents/users/$(userId)/categories/$(category))));
    }

    function isValidCategoryDoc(data) {
      return data.keys().hasOnly(['userId', 'name', 'archived', 'createdAt', 'updatedAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 40
        && data.name.matches('.*[^ ].*')
        && data.archived is bool;
    }

    function isValidBudget(userId, data) {
      return isValidCategory(userId, data.category)
        && data.year is int
        && data.year >= 2000
        && data.year <= 2100
        && data.month is int
        && data.month >= 1
        && data.month <= 12
        && data.limit is number
        && data.limit > 0
        && data.limit <= 1000000000;
    }

    // Vigencia recorrente: limit null encerra a recorrencia a partir do mes.
    function isValidRecurringBudget(userId, data) {
      return isValidCategory(userId, data.category)
        && data.year is int
        && data.year >= 2000
        && data.year <= 2100
        && data.month is int
        && data.month >= 1
        && data.month <= 12
        && (data.limit == null
          || (data.limit is number && data.limit > 0 && data.limit <= 1000000000));
    }

    // Id deterministico do orcamento: AAAA-MM-categoria (ex.: 2026-03-alimentacao).
    function expectedBudgetId(data) {
      return string(data.year) + '-' + (data.month < 10 ? '0' : '')
        + string(data.month) + '-' + data.category;
    }

    // Lancamento gerado por recorrencia: id rec-<recorrencia>-<AAAA-MM>.
    function isValidOccurrenceId(entryId, data) {
      return data.get('recurringId', '') == ''
        || entryId.matches('^rec-' + data.recurringId + '-[0-9]{4}-[0-9]{2}$');
    }

    function isValidCost(userId, data) {
      return isValidCategory(userId, data.category)
        && data.accountName is string
        && data.accountName.size() > 0
        && data.accountName.size() <= 200
        && data.get('description', '') is string
        && data.get('description', '').size() <= 500
        && data.get('recurringId', '') is string
        && (data.get('recurringId', '') == ''
          || data.recurringId.matches('^[A-Za-z0-9]{1,40}$'))
        && data.amount is number
        && data.amount > 0
        && data.costType in ['fixo', 'variavel']
        && data.installmentsTotal is int
        && data.installmentsTotal >= 1
        && data.installmentsTotal <= 120
        && data.competenceYear is int
        && data.competenceMonth is int
        && data.competenceMonth >= 1
        && data.competenceMonth <= 12;
    }

    // Recorrencia mensal (gera um lancamento por competencia no cliente).
    function isValidRecurringCost(userId, data) {
      return data.keys().hasOnly(['userId', 'accountName', 'amount', 'costType', 'category',
          'description', 'dayOfMonth', 'startYear', 'startMonth', 'active',
          'lastGeneratedYear', 'lastGeneratedMonth', 'createdAt', 'updatedAt'])
        && data.accountName is string
        && data.accountName.size() > 0
        && data.accountName.size() <= 200
        && data.amount is number
        && data.amount > 0
        && data.amount <= 1000000000
        && data.costType in ['fixo', 'variavel']
        && isValidCategory(userId, data.category)
        && data.get('description', '') is string
        && data.get('description', '').size() <= 500
        && data.dayOfMonth is int
        && data.dayOfMonth >= 1
        && data.dayOfMonth <= 28
        && data.startYear is int
        && data.startYear >= 2000
        && data.startYear <= 2100
        && data.startMonth is int
        && data.startMonth >= 1
        && data.startMonth <= 12
        && data.active is bool
        // Cursor completo: ano e mes juntos (ambos nulos ou ambos validos).
        && ((data.get('lastGeneratedYear', null) == null
            && data.get('lastGeneratedMonth', null) == null)
          || (data.get('lastGeneratedYear', null) is int
            && data.lastGeneratedYear >= 2000
            && data.lastGeneratedYear <= 2100
            && data.get('lastGeneratedMonth', null) is int
            && data.lastGeneratedMonth >= 1
            && data.lastGeneratedMonth <= 12));
    }

    // Meta de economia: alvo e prazo opcional (ano e mes juntos).
    function isValidGoal(data) {
      return data.keys().hasOnly(['userId', 'name', 'targetAmount', 'deadlineYear',
          'deadlineMonth', 'createdAt', 'updatedAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 60
        && data.targetAmount is number
        && data.targetAmount > 0
        && data.targetAmount <= 1000000000
        && ((data.get('deadlineYear', null) == null
            && data.get('deadlineMonth', null) == null)
          || (data.get('deadlineYear', null) is int
            && data.deadlineYear >= 2000
            && data.deadlineYear <= 2100
            && data.get('deadlineMonth', null) is int
            && data.deadlineMonth >= 1
            && data.deadlineMonth <= 12));
    }

    // Movimentacao de meta: deposito (> 0) ou retirada (< 0) em meta existente do usuario.
    function isValidContribution(userId, data) {
      return data.keys().hasOnly(['userId', 'goalId', 'amount', 'date', 'note', 'createdAt'])
        && data.goalId is string
        && data.goalId.matches('^[A-Za-z0-9]{1,40}$')
        && exists(/databases/$(database)/documents/users/$(userId)/savingsGoals/$(data.goalId))
        && data.amount is number
        && ((data.amount > 0 && data.amount <= 1000000000)
          || (data.amount < 0 && data.amount >= -1000000000))
        && data.date is timestamp
        && data.date >= timestamp.date(2000, 1, 1)
        && data.date <= request.time + duration.value(1, 'd')
        && data.get('note', '') is string
        && data.get('note', '').size() <= 200
        && data.get('createdAt', request.time) == request.time;
    }

    // Carimbos enviados pelo app (serverTimestamp) devem ser o horario do servidor.
    function hasServerTimestamps(data) {
      return data.get('createdAt', request.time) == request.time
        && data.get('updatedAt', request.time) == request.time;
    }

    function isPriceOrNull(value) {
      return value == null || (value is number && value > 0 && value <= 1000000000);
    }

    // Produto do catalogo de mercado (historico de preco resumido).
    function isValidGroceryProduct(data) {
      return data.keys().hasOnly(['userId', 'name', 'normalizedName', 'unit', 'lastUnitPrice',
          'previousUnitPrice', 'lastPurchasedAt', 'lastStore', 'purchaseCount', 'avgIntervalDays',
          'intervalCount', 'aliases', 'createdAt', 'updatedAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.normalizedName is string
        && data.normalizedName.size() > 0
        && data.normalizedName.size() <= 80
        && data.unit in ['un', 'kg', 'g', 'l', 'ml', 'pct']
        && isPriceOrNull(data.get('lastUnitPrice', null))
        && isPriceOrNull(data.get('previousUnitPrice', null))
        && (data.get('lastPurchasedAt', null) == null || data.lastPurchasedAt is timestamp)
        && data.get('lastStore', '') is string
        && data.get('lastStore', '').size() <= 60
        && data.get('purchaseCount', 0) is int
        && data.get('purchaseCount', 0) >= 0
        && (data.get('avgIntervalDays', null) == null
          || (data.avgIntervalDays is number && data.avgIntervalDays >= 0 && data.avgIntervalDays <= 3650))
        && data.get('intervalCount', 0) is int
        && data.get('intervalCount', 0) >= 0
        && data.get('aliases', []) is list
        && data.get('aliases', []).size() <= 10;
    }

    function isValidGroceryList(data) {
      return data.keys().hasOnly(['userId', 'name', 'status', 'items', 'purchaseId',
          'paidTotal', 'completedAt', 'createdAt', 'updatedAt', 'ownerName', 'memberIds', 'members'])
        && data.get('ownerName', '') is string
        && data.get('ownerName', '').size() <= 80
        && data.get('memberIds', []) is list
        && data.get('memberIds', []).size() <= 5
        && data.get('members', {}) is map
        && data.get('members', {}).size() <= 5
        && data.get('members', {}).keys().hasOnly(data.get('memberIds', []))
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 60
        && data.status in ['aberta', 'concluida']
        // Mapa items.{itemId} (atual: edicoes simultaneas por item) ou array (formato antigo).
        && (data.items is map || data.items is list)
        && data.items.size() <= 150
        && (data.get('purchaseId', null) == null
          || (data.purchaseId is string && data.purchaseId.size() <= 40))
        && (data.get('completedAt', null) == null || data.completedAt is timestamp)
        && isPriceOrNull(data.get('paidTotal', null))
        // Lista aberta nao carrega dados de conclusao.
        && (data.status == 'concluida'
          || (data.get('purchaseId', null) == null && data.get('paidTotal', null) == null));
    }

    // Compra registrada ao concluir a lista (imutavel).
    function isValidGroceryPurchase(data) {
      return data.keys().hasOnly(['userId', 'listId', 'store', 'purchasedAt', 'total',
          'costEntryId', 'items', 'receiptKey', 'ocrConfidence', 'createdAt'])
        && (data.get('listId', null) == null
          || (data.listId is string && data.listId.size() <= 40))
        && data.store is string
        && data.store.size() > 0
        && data.store.size() <= 60
        && data.purchasedAt is timestamp
        && data.total is number
        && data.total > 0
        && data.total <= 1000000000
        && data.costEntryId is string
        && data.costEntryId.size() <= 40
        && data.items is list
        && data.items.size() <= 150
        && (data.get('receiptKey', null) == null
          || (data.receiptKey is string && data.receiptKey.matches('^[A-Za-z0-9-]{1,64}$')))
        && (data.get('ocrConfidence', null) == null
          || (data.ocrConfidence is number && data.ocrConfidence >= 0 && data.ocrConfidence <= 100));
    }

    // Conclusao: compra NOVA, da propria lista, gravada no mesmo lote.
    // E-mail do login, confirmado (Google ja vem confirmado; e-mail e senha confirma pelo link).
    function tokenEmail() {
      return request.auth.token.get('email', '').lower();
    }

    function hasVerifiedEmail() {
      return isSignedIn()
        && tokenEmail().size() > 0
        && request.auth.token.get('email_verified', false) == true;
    }

    function listPath(ownerId, listId) {
      return /databases/$(database)/documents/users/$(ownerId)/groceryLists/$(listId);
    }

    function invitePath(inviteId) {
      return /databases/$(database)/documents/groceryInvites/$(inviteId);
    }

    function isListMember(data) {
      return isSignedIn() && request.auth.uid in data.get('memberIds', []);
    }

    // Participa de alguma lista do dono: le o catalogo e cria produto sem preco.
    function isGroceryMember(ownerId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(ownerId)/groceryMembers/$(request.auth.uid));
    }

    function isProductWithoutHistory(data) {
      return data.get('lastUnitPrice', null) == null
        && data.get('previousUnitPrice', null) == null
        && data.get('lastPurchasedAt', null) == null
        && data.get('lastStore', '') == ''
        && data.get('purchaseCount', 0) == 0
        && data.get('avgIntervalDays', null) == null
        && data.get('intervalCount', 0) == 0
        && data.get('aliases', []).size() == 0;
    }

    function isValidMemberEntry(entry) {
      return entry is map
        && entry.keys().hasOnly(['name', 'email'])
        && entry.name is string
        && entry.name.size() > 0
        && entry.name.size() <= 80
        && entry.email == tokenEmail();
    }

    function isNewPurchaseOf(userId, listId, purchaseId) {
      return purchaseId is string
        && !exists(/databases/$(database)/documents/users/$(userId)/groceryPurchases/$(purchaseId))
        && getAfter(/databases/$(database)/documents/users/$(userId)/groceryPurchases/$(purchaseId)).data.listId == listId;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      // Cadastro do proprio perfil: sempre com papel padrao (nunca auto-promocao).
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role == 'standard';

      // O proprio usuario atualiza dados de login/nome, mas nunca o papel.
      allow update: if isOwner(userId)
        && !changedKeys().hasAny(['role', 'createdAt'])
        && request.resource.data.get('uid', userId) == userId;

      // Admin altera somente nome e papel de OUTROS usuarios
      // (impede que o ultimo admin remova o proprio acesso).
      allow update: if isAdmin()
        && request.auth.uid != userId
        && changedKeys().hasOnly(['displayName', 'role', 'updatedAt'])
        && isValidRole(request.resource.data.role)
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0;

      allow delete: if false;

      // Preferencias de interface (tema, menu) — pessoais, inclusive para guest.
      match /settings/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Categorias personalizadas: nunca excluidas (arquivar preserva o historico).
      match /categories/{categoryId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && canWriteCosts()
          && request.resource.data.userId == userId
          && isValidCategoryDoc(request.resource.data);

        allow update: if isOwner(userId)
          && canWriteCosts()
          && !changedKeys().hasAny(['userId', 'createdAt'])
          && isValidCategoryDoc(request.resource.data);

        allow delete: if false;
      }

      match /groceryProducts/{productId} {
        allow read: if isOwner(userId) || isGroceryMember(userId);

        allow create: if isOwner(userId)
          && canWriteCosts()
          && request.resource.data.userId == userId
          && isValidGroceryProduct(request.resource.data)
          && hasServerTimestamps(request.resource.data);

        // Participante inclui produto novo no catalogo do dono, sempre sem preco.
        allow create: if isGroceryMember(userId)
          && canWriteCosts()
          && request.resource.data.userId == userId
          && isValidGroceryProduct(request.resource.data)
          && isProductWithoutHistory(request.resource.data)
          && hasServerTimestamps(request.resource.data);

        allow update: if isOwner(userId)
          && canWriteCosts()
          && !changedKeys().hasAny(['userId', 'createdAt'])
          && isValidGroceryProduct(request.resource.data);

        allow delete: if isOwner(userId) && canWriteCosts();
      }

      // Lista concluida e somente leitura (reaproveitar = nova lista).
      match /groceryLists/{listId} {
        // Participantes leem pela regra de grupo de colecoes (fim do arquivo).
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && canWriteCosts()
          && request.resource.data.userId == userId
          && request.resource.data.status == 'aberta'
          && request.resource.data.get('purchaseId', null) == null
          && request.resource.data.get('memberIds', []).size() == 0
          && request.resource.data.get('members', {}).size() == 0
          && isValidGroceryList(request.resource.data)
          && hasServerTimestamps(request.resource.data);

        allow update: if isOwner(userId)
          && canWriteCosts()
          && resource.data.status == 'aberta'
          && !changedKeys().hasAny(['userId', 'createdAt'])
          && isValidGroceryList(request.resource.data)
          // Lista ja em mapa nao volta a array (aba com versao antiga apagaria os itens).
          && (!(resource.data.items is map) || request.resource.data.items is map)
          // O dono so remove participantes; entrar exige o convite aceito pela pessoa.
          && request.resource.data.get('memberIds', []).hasOnly(resource.data.get('memberIds', []))
          // Concluir exige a compra registrada no mesmo lote.
          && (request.resource.data.status == 'aberta'
            || isNewPurchaseOf(userId, listId, request.resource.data.purchaseId));

        // Dono remove participante tambem de lista concluida.
        allow update: if isOwner(userId)
          && changedKeys().hasOnly(['memberIds', 'members', 'updatedAt'])
          && changedKeys().hasAny(['memberIds'])
          && request.resource.data.get('memberIds', []).hasOnly(resource.data.get('memberIds', []))
          && request.resource.data.get('members', {}).keys().hasOnly(resource.data.get('members', {}).keys());

        // Participante altera so os itens de lista aberta.
        allow update: if isListMember(resource.data)
          && canWriteCosts()
          && resource.data.status == 'aberta'
          && changedKeys().hasOnly(['items', 'updatedAt'])
          && request.resource.data.get('updatedAt', null) == request.time
          && isValidGroceryList(request.resource.data)
          && (!(resource.data.items is map) || request.resource.data.items is map);

        // Entrar na lista: so com o convite do proprio e-mail aceito no mesmo lote.
        allow update: if hasVerifiedEmail()
          && !isOwner(userId)
          && resource.data.status == 'aberta'
          && !(request.auth.uid in resource.data.get('memberIds', []))
          && changedKeys().hasOnly(['memberIds', 'members', 'updatedAt'])
          && request.resource.data.memberIds == resource.data.get('memberIds', []).concat([request.auth.uid])
          && isValidGroceryList(request.resource.data)
          && request.resource.data.members.diff(resource.data.get('members', {})).affectedKeys().hasOnly([request.auth.uid])
          && isValidMemberEntry(request.resource.data.members[request.auth.uid])
          // Convite pendente que passa a aceito NESTE lote (convite antigo nao reabre a lista).
          && get(invitePath(userId + '_' + listId + '_' + tokenEmail())).data.status == 'pendente'
          && getAfter(invitePath(userId + '_' + listId + '_' + tokenEmail())).data.status == 'aceito'
          && getAfter(invitePath(userId + '_' + listId + '_' + tokenEmail())).data.memberUid == request.auth.uid
          && getAfter(invitePath(userId + '_' + listId + '_' + tokenEmail())).data.ownerId == userId
          && getAfter(invitePath(userId + '_' + listId + '_' + tokenEmail())).data.listId == listId;

        // Sair da lista (aberta ou concluida).
        allow update: if isListMember(resource.data)
          && changedKeys().hasOnly(['memberIds', 'members', 'updatedAt'])
          && request.resource.data.get('memberIds', []) == resource.data.memberIds.removeAll([request.auth.uid])
          && request.resource.data.get('members', {}).diff(resource.data.get('members', {})).affectedKeys().hasOnly([request.auth.uid])
          && !(request.auth.uid in request.resource.data.get('members', {}));

        allow delete: if isOwner(userId) && canWriteCosts();
      }

      match /groceryPurchases/{purchaseId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && canWriteCosts()
          && request.resource.data.userId == userId
          && isValidGroceryPurchase(request.resource.data)
          && request.resource.data.get('createdAt', request.time) == request.time
          // O lancamento de mercado e gravado no mesmo lote.
          && existsAfter(/databases/$(database)/documents/users/$(userId)/costEntries/$(request.resource.data.costEntryId))
          // Comanda lida: a chave unica e registrada no mesmo lote, apontando para esta compra.
          && (request.resource.data.get('receiptKey', null) == null
            || getAfter(/databases/$(database)/documents/users/$(userId)/groceryReceiptKeys/$(request.resource.data.receiptKey)).data.purchaseId == purchaseId);

        allow update: if false;

        allow delete: if isOwner(userId) && canWriteCosts();
      }

      // Comanda ja lancada (id = chave): criada uma unica vez, junto com a compra.
      // Regravar a mesma chave e um update (negado): a comanda nao entra duas vezes.
      match /groceryReceiptKeys/{receiptKey} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && canWriteCosts()
          && receiptKey.matches('^[A-Za-z0-9-]{1,64}$')
          && request.resource.data.keys().hasOnly(['userId', 'purchaseId', 'purchasedAt', 'total', 'createdAt'])
          && request.resource.data.userId == userId
          && request.resource.data.purchaseId is string
          && request.resource.data.purchaseId.size() <= 40
          && request.resource.data.purchasedAt is timestamp
          && request.resource.data.total is number
          && request.resource.data.total > 0
          && request.resource.data.total <= 1000000000
          && request.resource.data.get('createdAt', request.time) == request.time
          && getAfter(/databases/$(database)/documents/users/$(userId)/groceryPurchases/$(request.resource.data.purchaseId)).data.get('receiptKey', null) == receiptKey;

        allow update: if false;

        allow delete: if isOwner(userId) && canWriteCosts();
      }

      // Acesso do participante ao catalogo do dono (criado ao aceitar um convite).
      match /groceryMembers/{memberUid} {
        allow get: if isOwner(userId) || (isSignedIn() && request.auth.uid == memberUid);
        allow list: if isOwner(userId);

        allow create, update: if hasVerifiedEmail()
          && request.auth.uid == memberUid
          && !isOwner(userId)
          && request.resource.data.keys().hasOnly(['ownerId', 'memberUid', 'email', 'name', 'listId', 'createdAt'])
          && request.resource.data.ownerId == userId
          && request.resource.data.memberUid == memberUid
          && request.resource.data.email == tokenEmail()
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.listId is string
          && request.resource.data.listId.size() <= 40
          && request.auth.uid in getAfter(listPath(userId, request.resource.data.listId)).data.get('memberIds', []);

        allow delete: if isOwner(userId) || (isSignedIn() && request.auth.uid == memberUid);
      }

      match /savingsGoals/{goalId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && canWriteCosts()
          && request.resource.data.userId == userId
          && isValidGoal(request.resource.data)
          && hasServerTimestamps(request.resource.data);

        allow update: if isOwner(userId)
          && canWriteCosts()
          && !changedKeys().hasAny(['userId', 'createdAt'])
          && isValidGoal(request.resource.data)
          && (!changedKeys().hasAny(['updatedAt'])
            || request.resource.data.updatedAt == request.time);

        allow delete: if isOwner(userId) && canWriteCosts();
      }

      // Movimentacoes sao imutaveis: corrigir = excluir e registrar de novo.
      match /goalContributions/{contributionId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && canWriteCosts()
          && request.resource.data.userId == userId
          && isValidContribution(userId, request.resource.data);

        allow update: if false;

        allow delete: if isOwner(userId) && canWriteCosts();
      }

      match /recurringCosts/{recurringId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && canWriteCosts()
          && request.resource.data.userId == userId
          && isValidRecurringCost(userId, request.resource.data);

        allow update: if isOwner(userId)
          && canWriteCosts()
          && !changedKeys().hasAny(['userId', 'createdAt'])
          && isValidRecurringCost(userId, request.resource.data);

        allow delete: if isOwner(userId) && canWriteCosts();
      }

      match /costEntries/{entryId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && canWriteCosts()
          && request.resource.data.userId == userId
          && isValidCost(userId, request.resource.data)
          && isValidOccurrenceId(entryId, request.resource.data);

        allow update: if isOwner(userId)
          && canWriteCosts()
          && request.resource.data.get('userId', userId) == userId
          && !changedKeys().hasAny(['userId', 'createdAt'])
          && isValidCost(userId, request.resource.data)
          && isValidOccurrenceId(entryId, request.resource.data);

        allow delete: if isOwner(userId) && canWriteCosts();
      }

      // Orcamento mensal por categoria (id deterministico AAAA-MM-categoria).
      match /budgetLimits/{budgetId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && canWriteCosts()
          && request.resource.data.userId == userId
          && isValidBudget(userId, request.resource.data)
          && budgetId == expectedBudgetId(request.resource.data);

        allow update: if isOwner(userId)
          && canWriteCosts()
          && !changedKeys().hasAny(['userId', 'year', 'month', 'category', 'createdAt'])
          && isValidBudget(userId, request.resource.data);

        allow delete: if isOwner(userId) && canWriteCosts();
      }

      // Vigencias de orcamento recorrente (id = mes de inicio AAAA-MM-categoria).
      match /recurringBudgets/{budgetId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && canWriteCosts()
          && request.resource.data.userId == userId
          && isValidRecurringBudget(userId, request.resource.data)
          && budgetId == expectedBudgetId(request.resource.data);

        allow update: if isOwner(userId)
          && canWriteCosts()
          && !changedKeys().hasAny(['userId', 'year', 'month', 'category', 'createdAt'])
          && isValidRecurringBudget(userId, request.resource.data);

        allow delete: if isOwner(userId) && canWriteCosts();
      }
    }

    // Convite para uma lista de mercado: id = {ownerId}_{listId}_{email}.
    match /groceryInvites/{inviteId} {
      function isInviteOwner() {
        return isSignedIn() && resource.data.ownerId == request.auth.uid;
      }

      function isInvitee() {
        return hasVerifiedEmail() && resource.data.email == tokenEmail();
      }

      allow read: if isInviteOwner() || isInvitee();

      allow create: if isSignedIn()
        && canWriteCosts()
        && request.resource.data.keys().hasOnly(['ownerId', 'ownerName', 'ownerEmail', 'listId', 'listName',
            'email', 'status', 'memberUid', 'createdAt', 'respondedAt'])
        && request.resource.data.ownerId == request.auth.uid
        // E-mail real de quem convida (o nome e livre; o e-mail nao).
        && request.resource.data.ownerEmail == tokenEmail()
        && request.resource.data.status == 'pendente'
        && request.resource.data.get('memberUid', null) == null
        && request.resource.data.get('respondedAt', null) == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 120
        && request.resource.data.email.matches('^[a-z0-9._%+-]+@[a-z0-9.-]+[.][a-z]{2,}$')
        && request.resource.data.email != tokenEmail()
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() > 0
        && request.resource.data.ownerName.size() <= 80
        && request.resource.data.listName is string
        && request.resource.data.listName.size() > 0
        && request.resource.data.listName.size() <= 60
        && request.resource.data.listId is string
        && request.resource.data.listId.size() <= 40
        && inviteId == request.auth.uid + '_' + request.resource.data.listId + '_' + request.resource.data.email
        // Lista propria, aberta e com vaga.
        && exists(listPath(request.auth.uid, request.resource.data.listId))
        && get(listPath(request.auth.uid, request.resource.data.listId)).data.status == 'aberta'
        && get(listPath(request.auth.uid, request.resource.data.listId)).data.get('memberIds', []).size() < 5;

      // Quem foi convidado aceita (entrando na lista no mesmo lote) ou recusa.
      allow update: if isInvitee()
        && resource.data.status == 'pendente'
        && changedKeys().hasOnly(['status', 'memberUid', 'respondedAt'])
        && request.resource.data.respondedAt == request.time
        && ((request.resource.data.status == 'recusado' && request.resource.data.get('memberUid', null) == null)
          || (request.resource.data.status == 'aceito'
            && request.resource.data.memberUid == request.auth.uid
            && request.auth.uid in getAfter(listPath(resource.data.ownerId, resource.data.listId)).data.get('memberIds', [])));

      // Apagar convite que ja nao existe nao faz mal (o lote de remover/sair nao trava).
      allow delete: if resource == null || isInviteOwner() || isInvitee();
    }

    // Listas compartilhadas comigo (consulta de grupo por memberIds) e leitura da lista.
    match /{path=**}/groceryLists/{listId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.get('memberIds', []);
    }
  }
}
