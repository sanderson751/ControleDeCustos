# Copie para .env.local e preencha com os dados do app Web do seu projeto Firebase
# (Console Firebase > Configuracoes do projeto > Seus apps > SDK setup and configuration).
#
# Estes valores sao PUBLICOS por design (vao no bundle do navegador). A seguranca
# dos dados e garantida pelas regras em firestore.rules, nao por estas chaves.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
